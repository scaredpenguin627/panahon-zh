# 统一换行符：仓库要在 Windows 和 Linux（云端）之间来回用。
# 脚本和源码一律 LF，否则 Linux 上的 bash 会报 "bad interpreter"。

* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.rs    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制资源不要做换行转换
*.otf   binary
*.apk   binary
*.png   binary
*.jks   binary
